{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ.example/schemas/civ.data-product-recipe.v1.schema.json",
  "title": "CIV deterministic data-product recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "recipe_id",
    "version",
    "product_name",
    "source",
    "dataset",
    "split",
    "topics",
    "license",
    "attribution",
    "rights_scope",
    "modifications"
  ],
  "properties": {
    "contract": {"const": "civ.data-product-recipe/v1"},
    "recipe_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "product_name": {"type": "string", "pattern": "^[^/\\\\]+\\.mcap$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dataset": {"type": "string", "minLength": 1},
    "split": {"enum": ["warmup", "development", "sealed"]},
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "attribution": {"type": "string", "minLength": 1},
    "rights_scope": {"type": "string", "minLength": 1},
    "modifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
