{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ.example/schemas/civ.attendee-fallback-pack.v1.schema.json",
  "title": "CIV attendee fallback pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "product_set_sha256", "datasets", "files", "required_disk_bytes"],
  "properties": {
    "contract": {"const": "civ.attendee-fallback-pack/v1"},
    "product_set_sha256": {"const": "d515c0a7cd748f8b2ad0cb41b93d8847b0917c2e6469be2f8be09582fc62ef9b"},
    "datasets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset", "full_rate_rows", "neutral_clip_count"],
        "properties": {
          "dataset": {"enum": ["kashiwa", "reims"]},
          "full_rate_rows": {"type": "integer", "minimum": 1},
          "neutral_clip_count": {"const": 3}
        }
      }
    },
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "required_disk_bytes": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "sha256", "byte_size"],
      "properties": {
        "target": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
