{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ.example/schemas/civ.submission-extension.v1.schema.json",
  "title": "CIV bounded submission extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "entries"],
  "properties": {
    "contract": {"const": "civ.submission-extension/v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "media_type", "path", "sha256"],
        "properties": {
          "kind": {"enum": ["agent-trace", "external-resource", "provenance", "regression-test"]},
          "media_type": {"enum": ["application/json", "application/x-ndjson", "application/yaml", "text/csv", "text/markdown", "text/plain"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
