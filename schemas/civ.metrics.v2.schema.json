{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ.example/schemas/civ.metrics.v2.schema.json",
  "title": "CIV unevaluated practice metrics v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "status", "reason", "aggregate", "datasets", "label_pack_sha256", "matching"],
  "properties": {
    "contract": {"const": "civ.metrics/v2"},
    "status": {"const": "not_evaluated"},
    "reason": {"type": "string", "minLength": 1},
    "aggregate": {"$ref": "#/$defs/unevaluated"},
    "datasets": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_sha256", "counts", "precision", "recall", "f1", "match_quality"],
        "properties": {
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "counts": {"type": "null"}, "precision": {"type": "null"},
          "recall": {"type": "null"}, "f1": {"type": "null"}, "match_quality": {"type": "null"}
        }
      }
    },
    "label_pack_sha256": {"type": "null"},
    "matching": {"type": "null"}
  },
  "$defs": {
    "unevaluated": {
      "type": "object", "additionalProperties": false,
      "required": ["counts", "precision", "recall", "f1", "match_quality"],
      "properties": {
        "counts": {"type": "null"}, "precision": {"type": "null"},
        "recall": {"type": "null"}, "f1": {"type": "null"}, "match_quality": {"type": "null"}
      }
    }
  }
}
