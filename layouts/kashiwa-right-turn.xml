<?xml version='1.0' encoding='UTF-8'?>
<!--
  PlotJuggler layout for the Kashiwa right-turn reference path.
  Series names follow the ROS 2 convention <topic>/<field>, matching the topics and
  fields named by examples/kashiwa/right_turn.yaml and docs/quickstart.md.
  Load the bag first, then File > Layout > Load Layout.
-->
<root>
  <tabbed_widget name="Main Window" parent="main_window">
    <Tab tab_name="Kashiwa right turn" containers="1">
      <Container>
        <DockSplitter count="2" orientation="-" sizes="0.6;0.4">
          <DockArea name="Steering angle (detector signal)">
            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
              <range top="40" bottom="-40" left="0" right="60"/>
              <limitY/>
              <curve name="/pix_hooke/v2a_steerstafb/vcu_chassis_steer_angle_fb" color="#1f77b4"/>
            </plot>
          </DockArea>
          <DockArea name="Evidence context">
            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
              <range top="10" bottom="-1" left="0" right="60"/>
              <limitY/>
              <curve name="/pix_hooke/v2a_drivestafb/vcu_chassis_speed_fb" color="#d62728"/>
              <curve name="/pix_hooke/v2a_vehiclestafb/vcu_chassis_errcode" color="#2ca02c"/>
              <curve name="/perception/object_recognition/is_object_detected/data" color="#ff7f0e"/>
            </plot>
          </DockArea>
        </DockSplitter>
      </Container>
    </Tab>
    <currentTabIndex index="0"/>
  </tabbed_widget>
  <use_relative_time_offset enabled="1"/>
</root>
