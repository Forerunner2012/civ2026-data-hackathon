<?xml version='1.0' encoding='UTF-8'?>
<!--
  PlotJuggler layout for the French left-turn reference path.
  Series names follow the ROS 2 convention <topic>/<field>, matching the topics and
  fields named by examples/french/left_turn.yaml and docs/quickstart.md.
  Load the bag first, then File > Layout > Load Layout.
-->
<root>
  <tabbed_widget name="Main Window" parent="main_window">
    <Tab tab_name="French left turn" containers="1">
      <Container>
        <DockSplitter count="2" orientation="-" sizes="0.6;0.4">
          <DockArea name="Yaw rate (detector signal)">
            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
              <range top="0.5" bottom="-0.5" left="0" right="60"/>
              <limitY/>
              <curve name="/zed/zed_node/imu/data/angular_velocity/z" color="#1f77b4"/>
            </plot>
          </DockArea>
          <DockArea name="Velocity components (detector signals)">
            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
              <range top="10" bottom="-10" left="0" right="60"/>
              <limitY/>
              <curve name="/fix_velocity/twist/twist/linear/x" color="#d62728"/>
              <curve name="/fix_velocity/twist/twist/linear/y" color="#2ca02c"/>
              <curve name="/fix_velocity/twist/twist/linear/z" color="#ff7f0e"/>
            </plot>
          </DockArea>
        </DockSplitter>
      </Container>
    </Tab>
    <currentTabIndex index="0"/>
  </tabbed_widget>
  <use_relative_time_offset enabled="1"/>
</root>
