next-env.d.ts

# Keep package.json and package-lock.json committed for reproducibility.
# Note: `build/` and `dist/` are ignored globally below/above for Python and
# ROS artifacts. A web sub-project that keeps *source* in `build/` must
# re-include it from its own .gitignore (see handoff-site/.gitignore).

